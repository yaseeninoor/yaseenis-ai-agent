{
  "name": "yaseenis-ai-agent",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AGENT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AGENT_GROUNDED_ONLY": "true"
  }
  // When your Cloudflare D1 database is ready, add:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "AI_YASEENI",
  //     "database_id": "YOUR_DATABASE_ID"
  //   }
  // ]
  //
  // When your EMS vector search binding is ready, expose it as:
  // "EMS_SEARCH"
}
